# Copy to .env and fill in your own values.

# Signs the session cookie that holds the Customer Account login.
SESSION_SECRET="change-me"

PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=your-storefront-api-token
PUBLIC_CHECKOUT_DOMAIN=checkout.your-store.com

# Customer Accounts (leave both empty to run without accounts).
# Login needs HTTPS locally: `npm run dev:https`.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=

## Optional
PUBLIC_STOREFRONT_ID=
# Injected by Oxygen for a linked storefront. When set, Storefront API calls
# use the private token and forward the buyer's IP.
# PRIVATE_STOREFRONT_API_TOKEN="your-private-storefront-api-token"

# Page content project
WEAVERSE_PROJECT_ID=your-project-id

# Optional editor and preview configuration
# WEAVERSE_API_KEY="your-api-key"
# WEAVERSE_HOST="https://studio.weaverse.io"
# WEAVERSE_API_BASE="https://api.weaverse.io"

# Additional services
# PUBLIC_GOOGLE_GTM_ID=
# JUDGEME_PRIVATE_API_TOKEN="your-judgeme-private-api-token"
# ALI_REVIEWS_API_KEY="your-ali-reviews-api-key"
# KLAVIYO_PRIVATE_API_TOKEN="your-klaviyo-private-api-token"

# Custom metafields and metaobjects
METAOBJECT_COLORS_TYPE="shopify--color-pattern"
CUSTOM_COLLECTION_BANNER_METAFIELD="custom.collection_banner"

# Inbox widget shop ID
PUBLIC_SHOPIFY_INBOX_SHOP_ID=
